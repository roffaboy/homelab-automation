{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:all"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^roles/[^/]+_stack/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "\\s[a-z_]+: (?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)+):(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "ansible-core 2.22 needs Python 3.13, and Ubuntu 24.04 has 3.12; raise this when 24.04 is no longer supported",
      "matchPackageNames": [
        "ansible-core"
      ],
      "allowedVersions": "<2.22"
    },
    {
      "matchDepNames": [
        "/linuxserver//"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?[^-]*-ls(?<build>\\d+)$"
    },
    {
      "description": "Patch updates merge by themselves once CI passes; autodeploy backs up and rolls back",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "patch updates",
      "automerge": true
    }
  ]
}
