# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
# {{ ansible_managed }}
# Based on the official TRaSH templates:
#   radarr: uhd-bluray-web           https://trash-guides.info/Radarr/radarr-setup-quality-profiles/
#   sonarr: web-1080p-alternative    https://trash-guides.info/Sonarr/sonarr-setup-quality-profiles/
# One profile per app, named {{ app_config_quality_profiles.radarr }} and {{ app_config_quality_profiles.sonarr }} (the Seerr defaults). Movies take the best
# there is and fall back: 2160p, then 1080p, then 720p, up to the sizes of app_config_recyclarr_sizes.
# No Remux: those files are 20-80 GB.
{% macro sizes(kind) %}
      qualities:
{% for q in app_config_profile_qualities[kind] + app_config_profile_extra_sizes[kind] %}
{% set res = '2160p' if '2160p' in q else ('1080p' if '1080p' in q else '720p') %}
        - name: {{ q }}
{% if not app_config_recyclarr_block_x265_hd | bool %}
          min: {{ app_config_recyclarr_x265_min_size }}
{% endif %}
          preferred: {{ app_config_recyclarr_sizes[kind].preferred[res] }}
          max: {{ app_config_recyclarr_sizes[kind].max[res] }}
{% endfor %}
{% endmacro %}

radarr:
  radarr:
    base_url: http://radarr:7878
    api_key: {{ _app_config_api_keys.radarr }}
    delete_old_custom_formats: true

    quality_definition:
      type: movie
{{ sizes('movie') }}
    quality_profiles:
      - trash_id: {{ app_config_trash_profiles.radarr }}  # UHD Bluray + WEB, with 1080p and 720p below it
        name: {{ app_config_quality_profiles.radarr }}
        # Best first: a release of a lower quality is taken when there is none of a higher one.
        qualities:
          - name: Bluray-2160p
          - name: WEB 2160p
            qualities:
              - WEBDL-2160p
              - WEBRip-2160p
          - name: Bluray-1080p
          - name: WEB 1080p
            qualities:
              - WEBDL-1080p
              - WEBRip-1080p
          - name: Bluray-720p
          - name: WEB 720p
            qualities:
              - WEBDL-720p
              - WEBRip-720p
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: {{ app_config_recyclarr_upgrades | bool | lower }}
          until_quality: Bluray-2160p

    custom_format_groups:
      add:
        # The TRaSH profile pulls this group in implicitly; it is listed so x265 (HD) can be excluded.
        - trash_id: f8bf8eab4617f12dfdbd16303d8da245  # [Optional] Golden Rule HD
{% if not app_config_recyclarr_block_x265_hd | bool %}
          exclude:
            - dc98083864ea246d05a42df0d05f81cc  # x265 (HD)
{% endif %}
        - trash_id: a3ac6af01d78e4f21fcb75f601ac96df  # [Unwanted] Unwanted Formats (BR-DISK, LQ, 3D, Extras, Upscaled, ...)

    media_naming:
      folder: jellyfin-imdb
      movie:
        rename: true
        standard: jellyfin-imdb

sonarr:
  sonarr:
    base_url: http://sonarr:8989
    api_key: {{ _app_config_api_keys.sonarr }}
    delete_old_custom_formats: true

    quality_definition:
      type: series
{{ sizes('series') }}
    quality_profiles:
      - trash_id: {{ app_config_trash_profiles.sonarr }}  # WEB-1080p (Alternative): WEB + Bluray 720p/1080p
        name: {{ app_config_quality_profiles.sonarr }}
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: {{ app_config_recyclarr_upgrades | bool | lower }}

    custom_format_groups:
      add:
        # The TRaSH profile pulls this group in implicitly; it is listed so x265 (HD) can be excluded.
        - trash_id: 158188097a58d7687dee647e04af0da3  # [Optional] Golden Rule HD
{% if not app_config_recyclarr_block_x265_hd | bool %}
          exclude:
            - 47435ece6b99a0b477caf360e79ba0bb  # x265 (HD)
{% endif %}
        - trash_id: 74aff4168620ed49dcc67e92b2c2a5b4  # [Optional] Language Profiles
        - trash_id: 85fae4a2294965b75710ef2989c850eb  # [Streaming Services] HD/UHD boost
        - trash_id: 59c3af66780d08332fdc64e68297098f  # [Unwanted] Unwanted Formats (BR-DISK, LQ, Extras, Upscaled, ...)

    media_naming:
      series: jellyfin-tvdb
      season: default
      episodes:
        rename: true
        standard: default
        daily: default
        anime: default
