---
# {{ ansible_managed }}
# Links go to the server's LAN address; widgets and status dots reach the apps on the Docker
# network.
{% macro href(app) %}http://{{ homelab_lan_ip }}:{{ homelab_ports[app] }}{% endmacro %}
{# One tile of the catalogue (inventory/group_vars/homelab/services.yml). #}
{% macro tile(key, t) %}
    - {{ t.title }}:
        icon: {{ t.icon }}
{% if t.link | default(true) %}
        href: {{ href(key) }}
{% endif %}
        siteMonitor: http://{{ t.host }}:{{ t.port }}{{ t.monitor_path | default('') }}
{% if t.widget is defined %}
        widget:
          type: {{ t.widget.type }}
{% if t.widget.version is defined %}
          version: {{ t.widget.version }}
{% endif %}
          url: http://{{ t.host }}:{{ t.port }}
{% if t.widget.auth | default('') == 'key' %}
          key: {{ t.widget.key }}
{% elif t.widget.auth | default('') == 'login' %}
          username: {{ homelab_username | to_json }}
          password: {{ homelab_password | to_json }}
{% endif %}
{% for name, value in (t.widget.extra | default({})).items() %}
          {{ name }}: {{ value | to_json }}
{% endfor %}
{% endif %}
{% endmacro %}
# Tiles by what they are for, grouped under tabs in settings.yaml (monitoring_stack).
{% for group in homelab_service_groups %}
{% set shown = [] %}
{% for key, t in homelab_services.items() if t.group == group and t.enabled | default(true) | bool %}
{% set _ = shown.append(key) %}
{% endfor %}
{% if shown | length > 0 %}

- {{ group }}:
{% for key in shown %}
{{ tile(key, homelab_services[key]) }}
{% endfor %}
{% endif %}
{% endfor %}
{% if homelab_monitoring | bool %}
{% if homelab_backup_remote %}

- Storage:
    # Sizes measured after each nightly backup (roles/backup); free space from node-exporter.
    - Storage:
        icon: mdi-harddisk
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 300000
          metrics:
            - label: Movies
              query: 'homelab_media_bytes{dir="movies"}'
              format:
                type: bytes
            - label: Series
              query: 'homelab_media_bytes{dir="series"}'
              format:
                type: bytes
            - label: Books
              query: 'homelab_media_bytes{dir="books"}'
              format:
                type: bytes
            - label: Free
              query: 'node_filesystem_avail_bytes{mountpoint="/"}'
              format:
                type: bytes
    # The nightly backup and the weekly check of it (roles/backup).
    - Backup:
        icon: mdi-backup-restore
        widget:
          type: prometheusmetric
          url: http://prometheus:9090
          refreshInterval: 300000
          metrics:
            - label: Last backup
              query: time() - homelab_backup_success_time
              format:
                type: duration
            - label: Last check
              query: time() - homelab_backup_verify_success_time
              format:
                type: duration
            - label: Size
              query: homelab_backup_bytes
              format:
                type: bytes
{% endif %}
{% endif %}
{% if app_config_github_repo and app_config_github_token %}

- Releases:
    # The latest release, from GitHub's API with a read-only token (app_config_github_token).
    # GitHub rejects requests without a User-Agent, and Homepage sends none by itself.
    - GitHub:
        icon: github.png
        href: https://github.com/{{ app_config_github_repo }}/releases
        widget:
          type: customapi
          url: https://api.github.com/repos/{{ app_config_github_repo }}/releases/latest
          headers:
            Authorization: Bearer {{ app_config_github_token }}
            Accept: application/vnd.github+json
            User-Agent: homelab-homepage
          refreshInterval: 300000
          mappings:
            - field: tag_name
              label: Release
            - field: published_at
              label: Released
              format: relativeDate
              style: short
{% endif %}
