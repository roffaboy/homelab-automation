---
# {{ ansible_managed }}
# https://gethomepage.dev/configs/settings/
title: Homelab
theme: {{ homelab_homepage_theme }}
color: slate
headerStyle: boxedWidgets
# A dot per app: green when its web UI answers (siteMonitor in services.yaml).
statusStyle: dot
# A tab per kind of app, a column per group in it, every tile the same size.
useEqualHeights: true
layout:
  # A column per group, the groups of a tab side by side (the tab and its groups: app_config,
  # homepage-services.yaml).
  Watch:
    tab: Media
  Request:
    tab: Media
  Read:
    tab: Media
  Library:
    tab: Downloads
  Sources:
    tab: Downloads
  Cleanup:
    tab: Downloads
  Monitoring:
    tab: System
  Storage:
    tab: System
  Releases:
    tab: System
  # The accounts, by what they are for (app_config, homepage.yml), a column each.
  Network:
    tab: Accounts
  Control:
    tab: Accounts
  Suggestions:
    tab: Accounts
  Subtitles:
    tab: Accounts
  Backup:
    tab: Accounts
  Other:
    tab: Accounts
