---
# {{ ansible_managed }}
# https://gethomepage.dev/configs/settings/
title: Homelab
theme: {{ homelab_homepage_theme }}
color: slate
headerStyle: boxedWidgets
# A dot per app: green when its web UI answers (siteMonitor in services.yaml).
statusStyle: dot
# A tab per group, every tile the same size.
useEqualHeights: true
layout:
  Media:
    tab: Media
    style: row
    columns: 4
  Downloads:
    tab: Downloads
    style: row
    columns: 4
  System:
    tab: System
    style: row
    columns: 4
  # The accounts, by what they are for (app_config, homepage.yml), a column each.
  Network:
    tab: Accounts
  Control:
    tab: Accounts
  Suggestions:
    tab: Accounts
  Subtitles:
    tab: Accounts
  Backup:
    tab: Accounts
  Other:
    tab: Accounts
